{
  "info": {
    "name": "Smartflo + Salesforce click-to-call",
    "description": "Tests the Smartflo APIs and the Salesforce webhook receiver. Fill the environment template with your own values and never commit them. Folder 2 places a real, billable call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Smartflo auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{smartflo_base_url}}/v1/auth/login",
            "description": "Generates a bearer token (valid about one hour).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{smartflo_email}}\",\n  \"password\": \"{{smartflo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.be.true;",
                  "  pm.expect(res.access_token).to.be.a('string');",
                  "  pm.environment.set('access_token', res.access_token);",
                  "  pm.environment.set('token_expiry', Date.now() + res.expires_in * 1000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{smartflo_base_url}}/v1/auth/refresh",
            "description": "Bearer format works for refresh as well as click-to-call.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh succeeds', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.be.true;",
                  "  pm.environment.set('access_token', res.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh with invalid token (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer not-a-real-token"
              }
            ],
            "url": "{{smartflo_base_url}}/v1/auth/refresh",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Invalid token is rejected', () => pm.expect(body.success).to.not.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (negative, run sparingly)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{smartflo_base_url}}/v1/auth/login",
            "description": "Repeated failed logins can lock the Smartflo account. Run this once at most.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{smartflo_email}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Wrong password is rejected', () => pm.expect(body.success).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Smartflo click-to-call",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Log in automatically when the token is missing or about to expire",
              "const expiry = parseInt(pm.environment.get('token_expiry') || '0', 10);",
              "if (!pm.environment.get('access_token') || Date.now() > expiry - 60000) {",
              "  pm.sendRequest({",
              "    url: pm.environment.get('smartflo_base_url') + '/v1/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json', 'Accept': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ email: pm.environment.get('smartflo_email'), password: pm.environment.get('smartflo_password') }) }",
              "  }, (err, res) => {",
              "    if (!err && res.json().success) {",
              "      pm.environment.set('access_token', res.json().access_token);",
              "      pm.environment.set('token_expiry', Date.now() + res.json().expires_in * 1000);",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Click to call (accepted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{smartflo_base_url}}/v1/click_to_call",
            "description": "BILLABLE: places a real call. Use your own phones. Remove the caller_id line if you have no caller ID to use. 'Accepted' only means queued, not answered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_number\": \"{{agent_number}}\",\n  \"destination_number\": \"{{destination_number}}\",\n  \"caller_id\": \"{{caller_id}}\",\n  \"async\": 1,\n  \"custom_identifier\": {\n    \"sfid\": \"{{sf_opportunity_id}}\",\n    \"usr\": \"{{sf_user_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request accepted', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.be.true;",
                  "  pm.expect(res.ref_id).to.be.a('string');",
                  "  pm.environment.set('ref_id', res.ref_id);",
                  "});"
                ]
              }
            }
          ]
        },
